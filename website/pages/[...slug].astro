---
import { getNode, getNodeBreadcrumbs, getNodeData, getSlugs } from 'slugtree'
import Root from '#/layouts/root.astro'
import Nav from '#/components/nav.astro'
import MdxRenderer from '#/components/mdx-renderer.astro'
import NotFound from '#/pages/404.astro'
import Sidebar from '#/components/sidebar.astro'
import HeaderArticle from '#/components/header-article.astro'
import FooterArticle from '#/components/footer-article.astro'
import TocSidebar from '#/components/toc-sidebar.astro'
import getModifiedDate from '#/lib/get-modified-date'
import { seo } from '#/const/seo'

export async function getStaticPaths() {
  return getSlugs().map((slug) => ({
    params: {
      slug: Array.isArray(slug) ? slug.join('/') : slug
    },
    props: {
      slug
    }
  }))
}

const { slug } = Astro.props

const node = getNode(slug)
const nodeData = node ? getNodeData(node.slug) : null
const modifiedTime = nodeData ? getModifiedDate(nodeData.filePath) : null
const breadcrumbs = node ? getNodeBreadcrumbs(node.slug) : []

const siteOrigin = Astro.site
  ? Astro.site.toString().replace(/\/$/, '')
  : seo.siteUrl.replace(/\/$/, '')

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString()

const docSchemas = node
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: node.title,
        description: node.description || seo.description,
        url: canonicalUrl,
        author: {
          '@type': 'Person',
          name: seo.author
        },
        publisher: {
          '@type': 'Organization',
          name: seo.name,
          url: siteOrigin
        },
        ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {})
      },
      ...(breadcrumbs.length > 0
        ? [
            {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: breadcrumbs.map((crumb, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name: crumb.title,
                item: crumb.href
                  ? new URL(crumb.href, siteOrigin).toString()
                  : canonicalUrl
              }))
            }
          ]
        : [])
    ]
  : undefined
---

{
  node ? (
    <Root
      title={node.title}
      description={node.description}
      type="article"
      modifiedTime={modifiedTime ?? undefined}
      schema={docSchemas}
    >
      <Nav />
      <main class="flex grow container">
        <Sidebar />
        <div class="flex grow">
          <article class="flex px-15 w-full flex-col">
            <HeaderArticle node={node} />
            <div class="prose__content grow pt-6">
              <MdxRenderer node={node} />
            </div>
            <FooterArticle node={node} />
          </article>
          <TocSidebar node={node} />
        </div>
      </main>
    </Root>
  ) : (
    <NotFound />
  )
}

<style is:global>
  @media (prefers-color-scheme: dark) {
    :root {
      --background: #0f0f0f;
    }
  }
</style>

<script>
  import { $$, $ } from '#/lib/dom'
  const $headings = $$('.prose__heading')

  $headings.forEach(($heading) => {
    const $icon = $('.prose__heading__icon', $heading)

    if (!$icon) return

    $icon.addEventListener('click', (e) => {
      e.stopPropagation()
      e.preventDefault()

      const slugId = $icon.dataset['slugId']
      const currentFullPath = location.href
      const url = new URL(currentFullPath)

      url.hash = `#${slugId}`

      window.navigator.clipboard.writeText(url.toString())

      $heading.dataset.copied = 'true'

      setTimeout(() => {
        delete $heading.dataset.copied
      }, 2000)
    })
  })
</script>
