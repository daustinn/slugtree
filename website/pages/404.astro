---
import Root from '#/layouts/root.astro'
import base from '#/lib/base'
---

<Root title="Page Not Found" noindex={true}>
  <article class="grow grid place-content-center text-center p-8">
    <h1 class="text-4xl font-bold font-google-sans mb-3">Page not found</h1>
    <p class="text-foreground/70 mb-6 max-w-md">
      The documentation page you are looking for doesn't exist or has moved.
    </p>
    <div>
      <a
        href={base('/docs')}
        class="inline-flex items-center px-4 py-2 rounded-lg bg-foreground text-background font-medium hover:opacity-90 transition-opacity text-sm"
      >
        Back to Documentation
      </a>
    </div>
  </article>
</Root>
