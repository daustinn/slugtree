---
import { getSlugs } from 'slugtree'
import Root from '@/layouts/root.astro'
export async function getStaticPaths() {
  return getSlugs().map((slug) => ({
    params: {
      path: Array.isArray(slug) ? slug.join('/') : slug
    },
    props: {
      slug
    }
  }))
}

const { slug } = Astro.props
---

<Root>
  {
    slug.length === 0 ? (
      <div>404</div>
    ) : (
      <>
        <div>Docs slug page</div>
        <div>{JSON.stringify(slug, null, 2)}</div>
      </>
    )
  }
</Root>
