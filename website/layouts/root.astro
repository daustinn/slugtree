---
import '#/styles/global.css'
import { seo } from '#/const/seo'
import base from '#/lib/base'

type Props = {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  class?: string
}

const {
  description = seo.description,
  title = seo.title,
  // image = seo.ogImage,
  // noindex = false,
  class: className = 'flex flex-col'
} = Astro.props

const pageTitle =
  title === seo.title ? `${seo.name} — ${title}` : `${title} — ${seo.name}`
---

<!doctype html>
<html lang="en" class="scroll-pt-30">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={base('/favicon.svg')} />
    <link rel="icon" href={base('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <title>
      {pageTitle}
    </title>
    <meta name="description" content={description} />
  </head>
  <body class:list={['min-h-svh font-geist', className]}>
    <slot />
  </body>
</html>

<script>
  import '#/scripts/menu'
</script>
