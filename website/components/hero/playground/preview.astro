---

---

<div class="relative grow flex flex-col p-4 overflow-hidden">
  <div
    class="relative grow rounded-xl border border-dashed border-border/70 bg-foreground/1 flex flex-col overflow-hidden"
  >
    <div
      class="flex items-center justify-between px-3 py-2 border-b border-dashed border-border/60 bg-foreground/2"
    >
      <div
        class="flex items-center gap-1.5 font-mono text-[10px] text-foreground/40"
      >
        <span
          class="w-2 h-2 rounded-full border border-border/80 bg-foreground/10 inline-block"
        ></span>
        <span
          class="w-2 h-2 rounded-full border border-border/80 bg-foreground/10 inline-block"
        ></span>
        <span
          class="w-2 h-2 rounded-full border border-border/80 bg-foreground/10 inline-block"
        ></span>
        <span
          id="preview-url-bar"
          class="ml-2 text-foreground/70 font-mono transition-colors"
          >/docs</span
        >
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse"></span>
        <div class="w-10 h-1.5 rounded-full bg-foreground/10"></div>
      </div>
    </div>

    <div
      class="grid grid-cols-12 grow divide-x divide-dashed divide-border/60 overflow-hidden"
    >
      <aside
        class="col-span-4 p-3 flex flex-col justify-between overflow-hidden bg-foreground/0.5"
      >
        <div class="space-y-1.5">
          <div
            class="font-mono text-[9px] uppercase tracking-wider text-foreground/30 px-1"
          >
            Navigation
          </div>
          <div id="preview-sidebar-list" class="space-y-1 text-xs"></div>
        </div>

        <div class="space-y-1 pt-2 opacity-30 pointer-events-none">
          <div class="w-3/4 h-1.5 rounded bg-foreground/30"></div>
          <div class="w-1/2 h-1.5 rounded bg-foreground/30"></div>
        </div>
      </aside>

      <main
        class="col-span-8 p-4 flex flex-col justify-between overflow-hidden bg-background"
      >
        <div class="space-y-2">
          <div
            id="preview-breadcrumbs"
            class="flex flex-wrap items-center gap-1 text-[10px] font-mono text-foreground/40"
          >
          </div>

          <h2
            id="preview-page-title"
            class="text-base font-semibold text-foreground tracking-tight transition-all"
          >
          </h2>

          <div class="space-y-1 pt-1">
            <div class="w-full h-2 rounded bg-foreground/15"></div>
            <div class="w-5/6 h-2 rounded bg-foreground/10"></div>
            <div class="w-4/6 h-2 rounded bg-foreground/10"></div>
          </div>
        </div>

        <div
          class="pt-3 border-t border-dashed border-border/40 grid grid-cols-2 gap-2"
          id="preview-pagination-box"
        >
          <div
            id="preview-prev-btn"
            class="p-2 rounded-lg border border-dashed border-border/50 text-[10px] truncate transition-colors"
          >
          </div>
          <div
            id="preview-next-btn"
            class="p-2 rounded-lg border border-dashed border-border/50 text-[10px] text-right truncate transition-colors"
          >
          </div>
        </div>
      </main>
    </div>
  </div>
</div>
