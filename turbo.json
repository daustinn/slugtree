{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#watch": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "//#build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "//#build": {
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#lint": {},
    "test": {
      "dependsOn": ["^test"]
    },
    "//#test": {
      "cache": false
    },
    "start": {
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"]
    }
  }
}
